{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byggplan-api",
  "main": "src/async-analysis-entry.ts",
  "compatibility_date": "2026-08-05",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "byggplan",
      "database_id": "917aeb03-1562-490b-8fae-049da42bfdff"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "byggplan-files"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "queues": {
    "producers": [
      {
        "binding": "ANALYSIS_QUEUE",
        "queue": "governing-document-analysis"
      }
    ],
    "consumers": [
      {
        "queue": "governing-document-analysis",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 1,
        "retry_delay": 10
      }
    ]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://byggplan.tunell.org",
    "DEV_USER_EMAIL": "hakan@byggplan.local",
    "AI_PROVIDER": "workers-ai",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "OPENAI_MODEL": "gpt-5.4-mini"
  }
}
